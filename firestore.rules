rules_version = '2';

// Firestore security rules for the forum.
//
// The web config in content/firebase.json is public by design — it identifies
// the project, it does not authorise anything. THIS FILE is the actual security
// boundary, which is why it is written defensively:
//
//   * everything is readable, nothing is writable without a signed-in user
//   * a user can only ever write their own uid into a document
//   * lengths are bounded here, not only in the form, because a form is a
//     suggestion and rules are enforcement
//   * nothing is ever hard-deleted by a normal user, so a thread cannot vanish
//     mid-argument; posts are tombstoned and stay auditable
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reading is open to everyone. Writing needs a CONFIRMED address.
    //
    // With email/password sign-up, an account proves only that somebody typed
    // an address into a box — not that it was theirs. Gating writes on
    // email_verified is the difference between a forum and an open relay, and
    // it belongs here rather than in the interface: a form is a suggestion,
    // a rule is enforcement.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Moderators are listed on their own user document by an administrator
    // editing Firestore directly. There is deliberately no way to grant
    // yourself this from the client.
    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator';
    }

    function textOk(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    // The client must stamp server time, so a post cannot claim to be from
    // last year in order to sit at the top of a sorted list.
    function freshTimestamp(field) {
      return field == request.time;
    }

    // A vote changes the running total on the parent document, and nothing
    // else. The step is bounded to what a single vote can actually do:
    //
    //   +1 / -1   a first vote, or taking one back
    //   +2 / -2   flipping from down to up or back
    //
    // BE HONEST ABOUT WHAT THIS DOES AND DOES NOT BUY:
    //
    // It stops the obvious attack — opening the console and writing
    // score = 9999. It does NOT stop somebody who scripts the two writes in a
    // loop, because with no server in between, the count and the permission to
    // change it necessarily live on the client.
    //
    // The real fix is to move counting to the licence service on the VPS,
    // where the vote document is the input and the total is never written by a
    // browser. Until that exists, the vote document per uid is the honest part
    // (it makes double-voting a rewrite, not an addition) and this bound is
    // the cheap part. Anyone reading a score should know it is only as good as
    // that.
    function scoreStepOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
        && request.resource.data.score is int
        && (request.resource.data.score - resource.data.score) in [1, -1, 2, -2];
    }

    // ── profiles ───────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;

      // A user may create and maintain their own profile, but may never set or
      // change `role` — that is the whole point of the function above.
      // The profile document is written on first sign-in, before the address
      // can possibly be confirmed, so it stays on signedIn().
      allow create: if isSelf(uid)
        && textOk(request.resource.data.displayName, 1, 60)
        && !('role' in request.resource.data);

      allow update: if isSelf(uid)
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && textOk(request.resource.data.displayName, 1, 60);

      allow delete: if false;
    }

    // ── threads ────────────────────────────────────────────────────────────
    match /threads/{threadId} {
      allow read: if true;

      allow create: if verified()
        && isSelf(request.resource.data.authorUid)
        && textOk(request.resource.data.title, 6, 140)
        && textOk(request.resource.data.body, 10, 8000)
        && request.resource.data.category in ['help', 'skills', 'false-positives', 'misses', 'ideas', 'showcase']
        && freshTimestamp(request.resource.data.createdAt)
        && request.resource.data.replyCount == 0
        && request.resource.data.deleted == false
        // Angepinnt wird nicht beim Anlegen. Sonst schreibt sich jeder seinen
        // eigenen Beitrag nach oben, und "oben" heisst dann nichts mehr.
        && (!('pinned' in request.resource.data) || request.resource.data.pinned == false);

      // The author may edit their own text or tombstone the thread. Reply count
      // and last-activity move on every reply, so they are writable by any
      // signed-in user — bounded to those two fields.
      allow update: if verified() && (
        isModerator()
        || (isSelf(resource.data.authorUid)
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.createdAt == resource.data.createdAt
            && textOk(request.resource.data.title, 6, 140)
            && textOk(request.resource.data.body, 10, 8000)
            // Der Verfasser darf seinen Text aendern und sonst nichts hier.
            // Ohne diese Zeile koennte er beim Bearbeiten `pinned` mitsetzen —
            // eine Berechtigung, die durch die Hintertuer kommt, ist die
            // schlimmere Sorte, weil sie in keiner Regel steht.
            && !('pinned' in request.resource.data.diff(resource.data).affectedKeys()))
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['replyCount', 'lastActivity'])
        || scoreStepOnly()
      );

      // Nothing is hard-deleted from the client. Removing a thread means
      // setting `deleted`, which keeps the record and the moderation trail.
      allow delete: if false;

      // ── votes ────────────────────────────────────────────────────────────
      //
      // One document per voter, named after their uid. That is the whole
      // anti-double-vote mechanism, and it is enforced here rather than in the
      // interface: a hidden button is a suggestion, a document id is a fact.
      // Voting twice means writing the same path twice, which overwrites
      // instead of adding.
      match /votes/{uid} {
        allow read: if true;
        allow create, update: if verified() && isSelf(uid)
          && request.resource.data.v is int
          && request.resource.data.v in [1, -1];
        allow delete: if verified() && isSelf(uid);
      }

      // ── replies ──────────────────────────────────────────────────────────
      match /posts/{postId} {
        allow read: if true;

        allow create: if verified()
          && isSelf(request.resource.data.authorUid)
          && textOk(request.resource.data.body, 1, 8000)
          && freshTimestamp(request.resource.data.createdAt)
          && request.resource.data.deleted == false;

        allow update: if verified() && (
          isModerator()
          || (isSelf(resource.data.authorUid)
              && request.resource.data.authorUid == resource.data.authorUid
              && request.resource.data.createdAt == resource.data.createdAt
              && textOk(request.resource.data.body, 1, 8000))
          || scoreStepOnly()
        );

        allow delete: if false;

        match /votes/{uid} {
          allow read: if true;
          allow create, update: if verified() && isSelf(uid)
            && request.resource.data.v is int
            && request.resource.data.v in [1, -1];
          allow delete: if verified() && isSelf(uid);
        }
      }
    }

    // Anything not matched above is denied. Adding a collection means adding a
    // rule for it on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
