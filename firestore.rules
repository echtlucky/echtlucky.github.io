rules_version = '2';

// Firestore security rules for the forum.
//
// The web config in content/firebase.json is public by design — it identifies
// the project, it does not authorise anything. THIS FILE is the actual security
// boundary, which is why it is written defensively:
//
//   * everything is readable, nothing is writable without a signed-in user
//   * a user can only ever write their own uid into a document
//   * lengths are bounded here, not only in the form, because a form is a
//     suggestion and rules are enforcement
//   * nothing is ever hard-deleted by a normal user, so a thread cannot vanish
//     mid-argument; posts are tombstoned and stay auditable
//
// Deploy with:  firebase deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Reading is open to everyone. Writing needs a CONFIRMED address.
    //
    // With email/password sign-up, an account proves only that somebody typed
    // an address into a box — not that it was theirs. Gating writes on
    // email_verified is the difference between a forum and an open relay, and
    // it belongs here rather than in the interface: a form is a suggestion,
    // a rule is enforcement.
    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Moderators are listed on their own user document by an administrator
    // editing Firestore directly. There is deliberately no way to grant
    // yourself this from the client.
    function isModerator() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'moderator';
    }

    function textOk(field, minLen, maxLen) {
      return field is string && field.size() >= minLen && field.size() <= maxLen;
    }

    // The client must stamp server time, so a post cannot claim to be from
    // last year in order to sit at the top of a sorted list.
    function freshTimestamp(field) {
      return field == request.time;
    }

    // A vote changes the running total on the parent document, and nothing
    // else. The step is bounded to what a single vote can actually do:
    //
    //   +1 / -1   a first vote, or taking one back
    //   +2 / -2   flipping from down to up or back
    //
    // BE HONEST ABOUT WHAT THIS DOES AND DOES NOT BUY:
    //
    // It stops the obvious attack — opening the console and writing
    // score = 9999. It does NOT stop somebody who scripts the two writes in a
    // loop, because with no server in between, the count and the permission to
    // change it necessarily live on the client.
    //
    // The real fix is to move counting to the licence service on the VPS,
    // where the vote document is the input and the total is never written by a
    // browser. Until that exists, the vote document per uid is the honest part
    // (it makes double-voting a rewrite, not an addition) and this bound is
    // the cheap part. Anyone reading a score should know it is only as good as
    // that.
    function scoreStepOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['score'])
        && request.resource.data.score is int
        && (request.resource.data.score - resource.data.score) in [1, -1, 2, -2];
    }

    // ── profiles ───────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if true;

      // A user may create and maintain their own profile, but may never set or
      // change `role` — that is the whole point of the function above.
      // The profile document is written on first sign-in, before the address
      // can possibly be confirmed, so it stays on signedIn().
      allow create: if isSelf(uid)
        && textOk(request.resource.data.displayName, 1, 60)
        && !('role' in request.resource.data);

      allow update: if isSelf(uid)
        && !('role' in request.resource.data.diff(resource.data).affectedKeys())
        && textOk(request.resource.data.displayName, 1, 60);

      allow delete: if false;
    }

    // ── threads ────────────────────────────────────────────────────────────
    match /threads/{threadId} {
      allow read: if true;

      allow create: if verified()
        && isSelf(request.resource.data.authorUid)
        && textOk(request.resource.data.title, 6, 140)
        && textOk(request.resource.data.body, 10, 8000)
        && request.resource.data.category in ['help', 'skills', 'false-positives', 'misses', 'ideas', 'showcase']
        && freshTimestamp(request.resource.data.createdAt)
        && request.resource.data.replyCount == 0
        && request.resource.data.deleted == false
        // Angepinnt wird nicht beim Anlegen. Sonst schreibt sich jeder seinen
        // eigenen Beitrag nach oben, und "oben" heisst dann nichts mehr.
        && (!('pinned' in request.resource.data) || request.resource.data.pinned == false);

      // The author may edit their own text or tombstone the thread. Reply count
      // and last-activity move on every reply, so they are writable by any
      // signed-in user — bounded to those two fields.
      allow update: if verified() && (
        isModerator()
        || (isSelf(resource.data.authorUid)
            && request.resource.data.authorUid == resource.data.authorUid
            && request.resource.data.createdAt == resource.data.createdAt
            && textOk(request.resource.data.title, 6, 140)
            && textOk(request.resource.data.body, 10, 8000)
            // Der Verfasser darf seinen Text aendern und sonst nichts hier.
            // Ohne diese Zeile koennte er beim Bearbeiten `pinned` mitsetzen —
            // eine Berechtigung, die durch die Hintertuer kommt, ist die
            // schlimmere Sorte, weil sie in keiner Regel steht.
            && !('pinned' in request.resource.data.diff(resource.data).affectedKeys()))
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['replyCount', 'lastActivity'])
        || scoreStepOnly()
      );

      // Nothing is hard-deleted from the client. Removing a thread means
      // setting `deleted`, which keeps the record and the moderation trail.
      allow delete: if false;

      // ── votes ────────────────────────────────────────────────────────────
      //
      // One document per voter, named after their uid. That is the whole
      // anti-double-vote mechanism, and it is enforced here rather than in the
      // interface: a hidden button is a suggestion, a document id is a fact.
      // Voting twice means writing the same path twice, which overwrites
      // instead of adding.
      match /votes/{uid} {
        allow read: if true;
        allow create, update: if verified() && isSelf(uid)
          && request.resource.data.v is int
          && request.resource.data.v in [1, -1];
        allow delete: if verified() && isSelf(uid);
      }

      // ── replies ──────────────────────────────────────────────────────────
      match /posts/{postId} {
        allow read: if true;

        allow create: if verified()
          && isSelf(request.resource.data.authorUid)
          && textOk(request.resource.data.body, 1, 8000)
          && freshTimestamp(request.resource.data.createdAt)
          && request.resource.data.deleted == false;

        allow update: if verified() && (
          isModerator()
          || (isSelf(resource.data.authorUid)
              && request.resource.data.authorUid == resource.data.authorUid
              && request.resource.data.createdAt == resource.data.createdAt
              && textOk(request.resource.data.body, 1, 8000))
          || scoreStepOnly()
        );

        allow delete: if false;

        match /votes/{uid} {
          allow read: if true;
          allow create, update: if verified() && isSelf(uid)
            && request.resource.data.v is int
            && request.resource.data.v in [1, -1];
          allow delete: if verified() && isSelf(uid);
        }
      }
    }

    // ── GeoBingo ───────────────────────────────────────────────────────────
    //
    // Eine Lobby ist etwas anderes als ein Forumsbeitrag, und diese Regeln sind
    // deshalb an drei Stellen bewusst lockerer — jede mit einem Grund.
    //
    // 1. `signedIn()` statt `verified()`, anonyme Anmeldungen eingeschlossen.
    //    Im Forum ist die bestaetigte Adresse die Huerde zwischen Forum und
    //    offenem Relais: was dort steht, steht oeffentlich und dauerhaft. Eine
    //    Lobby steht hinter einem Code, den nur bekommt wer ihn weitergereicht
    //    kriegt, und sie ist nach einer Runde Geschichte. Wer fuer zehn Minuten
    //    Bingo erst ein Konto anlegen und eine Mail oeffnen muss, spielt nicht.
    //
    // 2. `get` ja, `list` nein.
    //    Ohne diese Trennung koennte jeder Angemeldete die Sammlung `geobingo`
    //    abfragen und bekaeme jede offene Lobby mit ihrem Code. Eine Lobby
    //    findet man ueber ihren Code, nie ueber eine Liste. Die Unter-Sammlungen
    //    brauchen `list` (die Spielerliste ist eine Abfrage), aber dorthin kommt
    //    nur, wer den Code schon hat.
    //
    // 3. WAS DIESE REGELN NICHT KOENNEN, und das ist die Haelfte der Wahrheit:
    //    Ob auf einem Panorama wirklich ein Hund steht, kann keine
    //    Datenbankregel pruefen. Ein Fund ist erlaubt, weil er formal richtig
    //    aussieht, nicht weil er stimmt. Dagegen hilft nur die Auswertung, in
    //    der die Mitspieler den Daumen heben oder senken — sie ist deshalb kein
    //    Beiwerk, sondern die eigentliche Kontrolle. Genauso wird der
    //    Punktestand im Browser gerechnet: wer die Konsole aufmacht, kann sich
    //    in seiner eigenen Anzeige jede Zahl hinschreiben. Er aendert damit kein
    //    Dokument, also sehen die anderen weiter den richtigen Stand.
    match /geobingo/{code} {

      function lobby() {
        return get(/databases/$(database)/documents/geobingo/$(code)).data;
      }
      function istGastgeber() {
        return signedIn() && lobby().host == request.auth.uid;
      }
      function dabei() {
        return signedIn()
          && exists(/databases/$(database)/documents/geobingo/$(code)/spieler/$(request.auth.uid));
      }
      function einstOk(e) {
        return e.minuten is int && e.minuten >= 1 && e.minuten <= 90
          && e.bewegung in ['frei', 'pfeile', 'aus']
          && e.modus in ['einzeln', 'teams']
          && e.regionen is list && e.regionen.size() <= 40;
      }

      allow get: if signedIn();

      // Auflisten geht NUR fuer Lobbys, die ihr Gastgeber ausdruecklich
      // oeffentlich gestellt hat.
      //
      // Firestore wertet eine `list`-Regel gegen jedes Dokument aus, das die
      // Abfrage zurueckgeben wuerde. Eine Abfrage ohne
      // `where('oeffentlich','==',true)` liefert damit zwangslaeufig ein
      // privates Dokument mit, scheitert an dieser Zeile und wird komplett
      // abgewiesen. Der Lobby-Browser kann private Lobbys also nicht anzeigen,
      // auch nicht durch einen Fehler im Client — und `oeffentlich` liegt
      // deshalb als oberstes Feld hier und nicht unter `einst`.
      allow list: if signedIn() && resource.data.oeffentlich == true;

      allow create: if signedIn()
        && request.resource.data.host == request.auth.uid
        && request.resource.data.zustand == 'lobby'
        && request.resource.data.offen == true
        && request.resource.data.oeffentlich is bool
        && einstOk(request.resource.data.einst)
        && freshTimestamp(request.resource.data.angelegt);

      // Nur der Gastgeber schaltet weiter und stellt ein, und der Gastgeber
      // selbst ist unveraenderlich. Ohne die zweite Zeile koennte sich jeder,
      // der den Code kennt, zum Gastgeber machen und die Runde abbrechen.
      allow update: if istGastgeber()
        && request.resource.data.host == resource.data.host
        && request.resource.data.zustand in ['lobby', 'laeuft', 'pruefung', 'ergebnis']
        && request.resource.data.oeffentlich is bool
        && einstOk(request.resource.data.einst);

      allow delete: if istGastgeber();

      match /spieler/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid)
          && textOk(request.resource.data.name, 1, 24)
          && request.resource.data.team in ['a', 'b'];
        // Sich selbst austragen darf jeder, hinauswerfen nur der Gastgeber.
        allow delete: if isSelf(uid) || istGastgeber();
      }

      match /woerter/{wortId} {
        allow read: if signedIn();

        allow create: if dabei()
          && request.resource.data.vonUid == request.auth.uid
          && textOk(request.resource.data.text, 1, 40)
          && request.resource.data.p is int
          && request.resource.data.p in [1, 2, 3]
          && freshTimestamp(request.resource.data.angelegt);

        // Ein Wort wird nicht umgeschrieben, es wird geloescht und neu angelegt.
        // Sonst haette jemand mitten in der Runde aus "Ampel" einen
        // "Heissluftballon" machen koennen, und alle Funde daran waeren
        // ploetzlich Funde fuer etwas anderes gewesen.
        allow update: if false;
        allow delete: if signedIn() && (resource.data.vonUid == request.auth.uid || istGastgeber());
      }

      match /funde/{fundId} {
        allow read: if signedIn();

        // Die Kennung MUSS uid_wortId sein. Das ist die ganze Regel gegen den
        // zweiten Fund fuer dasselbe Wort: ein erneuter Klick schreibt auf
        // denselben Pfad und ueberschreibt, statt zu addieren.
        allow create, update: if dabei()
          && request.resource.data.uid == request.auth.uid
          && fundId == request.auth.uid + '_' + request.resource.data.wortId
          && request.resource.data.wortId is string
          && textOk(request.resource.data.wortText, 1, 40)
          && textOk(request.resource.data.pano, 1, 256)
          && request.resource.data.heading is number
          && request.resource.data.pitch is number
          && request.resource.data.fov is number
          && request.resource.data.fov >= 10
          && request.resource.data.fov <= 120
          && freshTimestamp(request.resource.data.angelegt);

        allow delete: if signedIn() && (resource.data.uid == request.auth.uid || istGastgeber());

        match /stimmen/{uid} {
          allow read: if signedIn();

          // Ueber den eigenen Fund stimmt niemand ab. Im Forum steht dieselbe
          // Ueberlegung als Kommentar; hier ist sie eine Regel, weil eine Runde
          // gegen drei Freunde sonst darin endet, dass jeder seine eigenen
          // Funde durchwinkt.
          allow create, update: if dabei() && isSelf(uid)
            && request.resource.data.v is int
            && request.resource.data.v in [1, -1]
            && get(/databases/$(database)/documents/geobingo/$(code)/funde/$(fundId)).data.uid != uid;

          // Auch der Gastgeber, und zwar nicht aus Machtgruenden: er raeumt
          // beim Verlassen die ganze Lobby ab, und eine Stimme, die er nicht
          // loeschen darf, bliebe als verwaister Pfad stehen.
          allow delete: if isSelf(uid) || istGastgeber();
        }
      }
    }

    // Anything not matched above is denied. Adding a collection means adding a
    // rule for it on purpose.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
